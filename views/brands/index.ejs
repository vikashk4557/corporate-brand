<%layout("/layouts/boilerplate")%>


<main>

    <section class="hero" id="home">
        <div class="hero__content">
            <h1 class="hero__title"><%= data.hero.title %></h1>
            <p> <%= data.hero.description %></p>
            <div class="hero__buttons">
                <a href="#services" class="hero-btn btn--primary"><%= data.hero.primaryButton %></a>
                <a href="#features" class="hero-btn btn--secondary"><%= data.hero.secondaryButton %></a>
            </div>
        </div>
        <div class="hero__image">
            <img
                src="/image/hero.webp"
                width="800"
                height="640"
                fetchpriority="high"
                decoding="async"
                alt="Modern digital solutions">
        </div>

    </section>
    
    <section class="services" id="services">
        <h2 class="section-title"><%= data.services.title %></h2>
        <div class="services__grid"><% data.services.items.forEach(service => { %>
            <div class="service">
                <div>
                    <h3 class="service-heading">
                        <i class="bi <%= service.icon %> icon <%= service.iconClass %>"></i>
                        <%= service.title %>
                    </h3>
                    <p>
                        <%= service.description %>
                    </p>
                </div>
                <div>
                    <a href="/services/<%= service.slug %>"
                    class="btn btn-dark btn--secondary hero-btn">
                        Learn More
                    </a>
                </div>
            </div>
        <% }) %>
        </div>
    </section>

    <section class="features" id="features">
        <h2 class="section-title"><%= data.features.title %></h2>
        <div class="features__grid">
            <% data.features.items.forEach(feature => { %>
                <a href="/feature/<%= feature.slug %>" class="feature" >
                    <h3 class="features-heading">
                        <i class="bi <%= feature.icon %> icon <%= feature.iconClass %>"></i>
                        <%= feature.title %>
                    </h3>
                    <p> <%= feature.description %></p>
                </a>
            <% }) %>
        </div>
    </section>
</main>



